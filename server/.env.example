DATABASE_URL=
PORT=

# --- DB connection pool (optional, these are the defaults) ---
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The full callback URL registered in Google Cloud Console
# Dev:  http://localhost:8000/api/v1/auth/google/callback
# Prod: https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# --- Auth / Session ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CLIENT_ORIGIN=http://localhost:5173